# Copy this file to .env and fill in values locally. Do not commit .env.

# Existing Gemini integration. Leave unset to keep deterministic answers.
GEMINI_API_KEY=

# Server-side generateContent models. GEMINI_API_KEY stays on the server.
# Default: gemini-4-hydrogen. Cost-efficient fallback: gemini-3.5-flash-lite.
# Gemini 4 rejects thinking level MINIMAL; the server uses LOW for Gemini 4.
GEMINI_MODEL=gemini-4-hydrogen
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Browser Supabase client. Use the project URL and the publishable (anon) key.
# Never put the service-role key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server token checks. May repeat the same project URL and publishable key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Provisioning only (scripts/provision-demo-users.ts). Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Shared demonstration password, read only by the provisioning script.
DEMO_ACCOUNT_PASSWORD=

# APP_URL is unused by the application server.
APP_URL=
